#!/bin/bash
# curral base build — generated, runs once as root inside the build VM.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
log() { echo "curral-build: $*"; }
aptq() { apt-get -q -o DPkg::Lock::Timeout=600 "$@"; }
. /etc/os-release
# The build VM's only exit is curral's egress proxy (public hosts only).
export http_proxy={{.Proxy}} https_proxy={{.Proxy}} HTTP_PROXY={{.Proxy}} HTTPS_PROXY={{.Proxy}}
export no_proxy=localhost,127.0.0.1{{if .Caches}},{{.CacheAddr}}{{end}} NO_PROXY=localhost,127.0.0.1{{if .Caches}},{{.CacheAddr}}{{end}}
printf 'Acquire::http::Proxy "%s";\nAcquire::https::Proxy "%s";\n' {{.Proxy}} {{.Proxy}} > /etc/apt/apt.conf.d/95curral-build-proxy
{{- range .CacheEnv}}
export {{.}}
{{- end}}
{{- if .CacheApt}}
cat > /etc/apt/apt.conf.d/94curral-build-cache <<'CURRAL_CACHE'
{{.CacheApt}}CURRAL_CACHE
{{- end}}

log "disabling background package jobs"
systemctl disable --now unattended-upgrades.service apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
systemctl stop apt-daily.service apt-daily-upgrade.service 2>/dev/null || true
systemctl mask apt-daily.service apt-daily-upgrade.service 2>/dev/null || true

log "updating packages"
aptq update
aptq -y -o Dpkg::Options::=--force-confold dist-upgrade
aptq -y install --no-install-recommends ca-certificates curl jq xz-utils gnupg
{{- if .Packages}}
aptq -y install --no-install-recommends {{join .Packages " "}}
{{- end}}
{{- if .Docker}}

log "installing docker"
install -d -m 0755 /etc/apt/keyrings
curl -fsSL "https://download.docker.com/linux/${ID}/gpg" -o /tmp/docker.asc
fpr=$(gpg --show-keys --with-colons /tmp/docker.asc | awk -F: '$1=="fpr"{print $10; exit}')
[ "$fpr" = "9DC858229FC7DD38854AE2D88D81803C0EBFCD88" ] || { log "docker key fingerprint mismatch: $fpr"; exit 1; }
gpg --dearmor -o /etc/apt/keyrings/docker.gpg /tmp/docker.asc
if curl -fsS -o /dev/null "https://download.docker.com/linux/${ID}/dists/${VERSION_CODENAME}/Release"; then
  echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/${ID} ${VERSION_CODENAME} stable" > /etc/apt/sources.list.d/docker.list
  aptq update
  aptq -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
else
  log "no docker repo for ${ID} ${VERSION_CODENAME}; using distro packages"
  aptq -y install docker.io docker-compose-v2 || aptq -y install docker.io
fi
usermod -aG docker {{.User}}
systemctl enable docker
{{- end}}
{{- if .Node}}

log "installing node {{.Node}}"
base="https://nodejs.org/dist/latest-v{{.Node}}.x"
curl -fsSL "$base/SHASUMS256.txt" -o /tmp/node.sums
tarball=$(awk '/ node-v[0-9.]+-linux-x64\.tar\.xz$/{print $2; exit}' /tmp/node.sums)
[ -n "$tarball" ] || { log "node {{.Node}} not found"; exit 1; }
curl -fsSL "$base/$tarball" -o "/tmp/$tarball"
(cd /tmp && grep " $tarball\$" node.sums | sha256sum -c -)
tar -xJf "/tmp/$tarball" -C /usr/local --strip-components=1 --no-same-owner
rm -f "/tmp/$tarball" /tmp/node.sums
node --version
{{- end}}
{{- if .Go}}

log "installing go {{.Go}}"
gover="{{.Go}}"
curl -fsSL "https://go.dev/dl/?mode=json&include=all" -o /tmp/go.json
if [[ "$gover" =~ ^1\.[0-9]+$ ]]; then
  gover=$(jq -r --arg p "go$gover." '[.[] | select(.stable and (.version|startswith($p)))][0].version // empty' /tmp/go.json | sed 's/^go//')
  [ -n "$gover" ] || { log "no stable go {{.Go}}.x release"; exit 1; }
fi
gosum=$(jq -r --arg v "go$gover" '.[] | select(.version==$v) | .files[] | select(.os=="linux" and .arch=="amd64" and .kind=="archive") | .sha256' /tmp/go.json)
[ -n "$gosum" ] || { log "go $gover not found"; exit 1; }
curl -fsSL "https://go.dev/dl/go$gover.linux-amd64.tar.gz" -o /tmp/go.tgz
echo "$gosum  /tmp/go.tgz" | sha256sum -c -
rm -rf /usr/local/go && tar -xzf /tmp/go.tgz -C /usr/local
ln -sf /usr/local/go/bin/go /usr/local/go/bin/gofmt /usr/local/bin/
rm -f /tmp/go.tgz /tmp/go.json
go version
{{- end}}
{{- if .UV}}

log "installing uv"
uvbase="https://github.com/astral-sh/uv/releases/latest/download"
curl -fsSL "$uvbase/uv-x86_64-unknown-linux-gnu.tar.gz" -o /tmp/uv.tgz
curl -fsSL "$uvbase/uv-x86_64-unknown-linux-gnu.tar.gz.sha256" -o /tmp/uv.sha256
echo "$(awk '{print $1}' /tmp/uv.sha256)  /tmp/uv.tgz" | sha256sum -c -
tar -xzf /tmp/uv.tgz -C /usr/local/bin --strip-components=1 --no-same-owner
rm -f /tmp/uv.tgz /tmp/uv.sha256
uv --version
{{- end}}
{{- if .Python}}

log "installing python {{.Python}}"
export UV_PYTHON_INSTALL_DIR=/opt/uv-python
uv --no-progress python install {{.Python}}
py="$(cd / && uv python find --managed-python {{.Python}})"
ln -sf "$py" /usr/local/bin/python{{.Python}}
ln -sf "$py" /usr/local/bin/python
python{{.Python}} --version
{{- end}}
{{- if .GH}}

log "installing gh"
ghver=$(curl -fsSL https://api.github.com/repos/cli/cli/releases/latest | jq -r .tag_name | sed 's/^v//')
case "$ghver" in [0-9]*.[0-9]*.[0-9]*) ;; *) log "bad gh version: $ghver"; exit 1;; esac
ghbase="https://github.com/cli/cli/releases/download/v$ghver"
curl -fsSL "$ghbase/gh_${ghver}_linux_amd64.tar.gz" -o /tmp/gh.tgz
curl -fsSL "$ghbase/gh_${ghver}_checksums.txt" -o /tmp/gh.sums
echo "$(awk -v f="gh_${ghver}_linux_amd64.tar.gz" '$2==f{print $1}' /tmp/gh.sums)  /tmp/gh.tgz" | sha256sum -c -
tar -xzf /tmp/gh.tgz -C /usr/local --strip-components=1 --no-same-owner "gh_${ghver}_linux_amd64/bin/gh"
rm -f /tmp/gh.tgz /tmp/gh.sums
gh --version
{{- end}}
{{- if .Tea}}

log "installing tea"
teaver=$(curl -fsSL https://gitea.com/api/v1/repos/gitea/tea/releases/latest | jq -r .tag_name | sed 's/^v//')
case "$teaver" in [0-9]*.[0-9]*.[0-9]*) ;; *) log "bad tea version: $teaver"; exit 1;; esac
teabase="https://dl.gitea.com/tea/$teaver"
curl -fsSL "$teabase/tea-$teaver-linux-amd64.xz" -o /tmp/tea.xz
curl -fsSL "$teabase/tea-$teaver-linux-amd64.xz.sha256" -o /tmp/tea.sha256
echo "$(awk '{print $1}' /tmp/tea.sha256)  /tmp/tea.xz" | sha256sum -c -
xz -dc /tmp/tea.xz > /usr/local/bin/tea
chmod 0755 /usr/local/bin/tea
rm -f /tmp/tea.xz /tmp/tea.sha256
tea --version
{{- end}}

# with-env FILE CMD...: CMD with FILE's NAME=value lines in its environment.
install -d -m 0755 /usr/local/lib/curral
cat > {{.WithEnv}} <<'CURRAL_SCRIPT'
#!/bin/sh
f=$1
shift
if [ -r "$f" ]; then
  while IFS= read -r l; do
    case $l in ''|'#'*) ;; *=*) export "$l" ;; esac
  done < "$f"
fi
exec "$@"
CURRAL_SCRIPT
chmod 0755 {{.WithEnv}}
{{- if .AgentPkgs}}

log "installing agents"
npm install -g --no-fund --no-audit --loglevel=error {{join .AgentPkgs " "}}
{{- range .AgentBins}}
{{.}} --version
{{- end}}
{{- if .Claude}}
# curral pushes Claude Code's token or key to ~/{{.ClaudeEnvFile}}, and only
# claude loads it: other agents and sessions don't get it in their environment.
bin=$(command -v claude)
ln -sfn "$(readlink -f "$bin")" {{.ClaudeReal}}
rm -f "$bin"
cat > "$bin" <<'CURRAL_SCRIPT'
#!/bin/sh
exec {{.WithEnv}} "$HOME/{{.ClaudeEnvFile}}" {{.ClaudeReal}} "$@"
CURRAL_SCRIPT
chmod 0755 "$bin"
claude --version
{{- end}}
# No self-updates, telemetry or background catalog fetches: the VM only reaches
# allowlisted hosts, and versions change by rebuilding the base.
cat >> /etc/environment <<'CURRAL_ENV'
{{- range .AgentEnv}}
{{.}}
{{- end}}
CURRAL_ENV
{{- end}}
{{- if .OMP}}

log "installing omp"
tag={{.OMP}}
if [ "$tag" = latest ]; then
  tag=$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/can1357/oh-my-pi/releases/latest)
  tag=${tag##*/}
fi
case "$tag" in v[0-9]*.[0-9]*.[0-9]*) ;; *) log "bad omp version: $tag"; exit 1;; esac
# SHA256SUMS comes from the same release: it guards against a broken
# download, not a tampered release (pin agents.omp.version for that).
rel=https://github.com/can1357/oh-my-pi/releases/download/$tag
curl -fsSL -o /tmp/omp-linux-x64 "$rel/omp-linux-x64"
curl -fsSL -o /tmp/omp-SHA256SUMS "$rel/SHA256SUMS.txt"
(cd /tmp && grep -E '^[0-9a-f]{64} [ *]omp-linux-x64$' omp-SHA256SUMS | sha256sum -c -)
install -m 0755 /tmp/omp-linux-x64 /usr/local/bin/omp
rm -f /tmp/omp-linux-x64 /tmp/omp-SHA256SUMS
omp --version
# No update or marketplace checks: versions change by rebuilding the base.
sudo -u {{.User}} -H omp config set startup.checkUpdate false
sudo -u {{.User}} -H omp config set marketplace.autoUpdate off
{{- end}}
{{- range .Scripts}}

log "running {{.}}"
bash "/var/lib/curral/build/scripts/{{.}}"
{{- end}}

# curral run starts agents through curral-env, so a long-lived tmux server
# still gives them the environment pushed at the latest start.
cat > /usr/local/bin/curral-env <<'CURRAL_SCRIPT'
#!/bin/sh
exec {{.WithEnv}} "$HOME/.ssh/environment" "$@"
CURRAL_SCRIPT
chmod 755 /usr/local/bin/curral-env
# Prefix C-a so the guest's tmux doesn't clash with a host tmux on C-b.
cat > /etc/tmux.conf <<'CURRAL_TMUX'
set -g prefix C-a
unbind C-b
bind C-a send-prefix
CURRAL_TMUX

log "cleaning up"
aptq -y autoremove
apt-get clean
rm -f /etc/apt/apt.conf.d/95curral-build-proxy
{{- if .CacheApt}}
rm -f /etc/apt/apt.conf.d/94curral-build-cache
{{- end}}
cloud-init clean --logs --machine-id
rm -f /etc/ssh/ssh_host_*
fstrim -av || true
log "done"
