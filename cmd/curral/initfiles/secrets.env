## curral secrets: NAME=value lines, looked up after config.yaml secrets: and the
## environment. Uncomment the ones you use. Keep this file mode 0600.
## No inline comments or escapes: everything after = is the value.

## Claude Code, auth: oauth-token (the default). Create it with: claude setup-token
# CLAUDE_CODE_OAUTH_TOKEN=

## Claude Code with auth: api-key; also a provider key for opencode, pi and omp.
# ANTHROPIC_API_KEY=

## Codex with auth: api-key; also a provider key for opencode, pi and omp.
# OPENAI_API_KEY=

## Provider keys for opencode, pi and omp (agents.<agent>.keys in a template).
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=

## Any other name can be referenced as secret:NAME: forge tokens and passwords
## (curral forge add --token-secret / --password-secret), notification tokens,
## template env: and mcp: headers. For example:
# GH_ADMIN_TOKEN=
# NTFY_TOKEN=
